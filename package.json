{
  "name": "screenshot-capturer-extension",
  "version": "1.0.5",
  "type": "module",
  "description": "Chrome extension to capture a screenshot and save to clipboard",
  "keywords": [
    "chrome-extension",
    "screenshot",
    "context-menu",
    "clipboard"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/webext-quick-capture.git"
  },
  "homepage": "https://github.com/mridang/webext-quick-capture",
  "bugs": "https://github.com/mridang/webext-quick-capture/issues",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup --config=rollup.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:coverage": "jest --verbose --config=jest.config.mjs --coverage",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "npm run test -- --watch"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.2.0",
    "@mridang/eslint-defaults": "^2.1.0",
    "@mridang/semantic-release-crx": "^1.0.1",
    "@playwright/test": "^1.57.0",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/chrome": "^0.0.280",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "rollup": "^4.62.0",
    "rollup-plugin-copy": "^3.5.0",
    "semantic-release": "^25.0.0",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@eslint/core": "1.2.1"
  },
  "sideEffects": true,
  "exports": {
    "./package.json": "./package.json"
  }
}
