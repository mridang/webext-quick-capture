{
  "name": "screenshot-capturer-extension",
  "version": "1.0.2",
  "type": "module",
  "description": "Chrome extension to capture a screenshot and save to clipboard",
  "keywords": [
    "chrome-extension",
    "screenshot",
    "context-menu",
    "clipboard"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "license": "Apache-2.0",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/webext-quick-capture.git"
  },
  "homepage": "https://github.com/mridang/webext-quick-capture",
  "bugs": "https://github.com/mridang/webext-quick-capture/issues",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "rollup --config=rollup.config.mjs",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:watch": "npm run test -- --watch",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:coverage": "jest --verbose --config=jest.config.mjs --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@mridang/eslint-defaults": "^1.7.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@tsconfig/node22": "^22.0.6",
    "@types/chrome": "^0.3.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "rollup-plugin-copy": "^3.5.0",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
